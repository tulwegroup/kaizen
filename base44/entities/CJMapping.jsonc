{
  "name": "CJMapping",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "product",
        "variant",
        "order",
        "shipment",
        "supplier"
      ],
      "description": "Type of canonical entity being mapped"
    },
    "canonical_id": {
      "type": "string",
      "description": "Canonical system entity ID"
    },
    "cj_id": {
      "type": "string",
      "description": "CJdropshipping object ID (product, variant/sku, order ID)"
    },
    "cj_sku": {
      "type": "string",
      "description": "CJ SKU identifier for variants"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "failed",
        "drift_detected"
      ],
      "default": "pending"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "canonical_status": {
      "type": "string",
      "description": "Normalized canonical status at last sync"
    },
    "cj_status_raw": {
      "type": "string",
      "description": "Raw CJ status string at last sync"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (product title, tracking number, etc.)"
    }
  },
  "required": [
    "entity_type",
    "canonical_id",
    "cj_id"
  ]
}