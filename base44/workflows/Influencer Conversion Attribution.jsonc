{
  "name": "Influencer Conversion Attribution",
  "description": "When a Shopify order mapping is created, checks for an influencer discount code and records the conversion",
  "trigger": {
    "condition": "${ (.trigger.data.entity_type == \"order\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ShopifyMapping"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "influencer_conversion_attribution",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "influencerTracking",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "influencerTracking"
  }
}